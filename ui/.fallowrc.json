{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/v3.33.1/schema.json",
  // The pages scripts/build-ui.sh builds.
  "entry": ["src/login.ts", "src/setup.ts", "src/account.ts", "styles/app.css"],
  // A verbatim copy of the design system's styles; it is checked in that repository.
  "duplicates": { "ignore": ["styles/vendor/**"] },
  "health": { "ignore": ["styles/vendor/**"] },
  // A page imports only webauthn.ts, never another page.
  "boundaries": {
    "zones": [
      { "name": "pages", "patterns": ["src/login.ts", "src/setup.ts", "src/account.ts"] },
      { "name": "webauthn", "patterns": ["src/webauthn.ts"] }
    ],
    "rules": [
      { "from": "pages", "allow": ["webauthn"] },
      { "from": "webauthn", "allow": [] }
    ],
    "coverage": { "requireAllFiles": true, "allowUnmatched": ["styles/**"] }
  },
  "audit": { "deadCodeBaseline": "fallow-baseline.json" },
  "rules": { "policy-violation": "off" }
}
